{
  "entities": {
    "Application": {
      "title": "Application",
      "description": "Grassroots organisation technology support application submitted via the public 32-field Apply form and managed by SEVA admins. Uses a compact top-level envelope with a bounded profile map to keep Firestore Security Rules well within expression limits.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique application reference ID (e.g. SEVA-2026-1119-4821)"
        },
        "status": {
          "type": "string",
          "maxLength": 60,
          "enum": [
            "New Application",
            "Under Initial Review",
            "Additional Information Required",
            "Shortlisted",
            "Meeting Scheduled",
            "Approved",
            "Rejected",
            "On Hold",
            "Agreement Pending",
            "Implementation Started",
            "Implementation Completed"
          ]
        },
        "priority": {
          "type": "string",
          "maxLength": 20,
          "enum": ["High", "Medium", "Low"]
        },
        "created_at": { "type": "string", "minLength": 10, "maxLength": 64 },
        "updated_at": { "type": "string", "minLength": 10, "maxLength": 64 },
        "server_created_at": { "type": "string", "format": "date-time" },
        "server_updated_at": { "type": "string", "format": "date-time" },
        "name_of_organization": { "type": "string", "minLength": 1, "maxLength": 250 },
        "organisation_email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "state": { "type": "string", "minLength": 1, "maxLength": 100 },
        "district": { "type": "string", "minLength": 1, "maxLength": 100 },
        "profile": {
          "type": "object",
          "description": "Bounded map (max 40 keys) containing organisational profile, contact details, infrastructure, challenges, timeline, and priorities."
        },
        "documents": { "type": "array", "description": "Optional list of uploaded supporting document metadata (max 10)." },
        "status_history": { "type": "array", "description": "Audit trail of status transitions (max 50)." },
        "reviews": { "type": "object", "description": "Admin-only evaluation rubric and score object." },
        "assigned_reviewer_id": { "type": "string", "maxLength": 128 },
        "assigned_reviewer_name": { "type": "string", "maxLength": 150 }
      },
      "required": [
        "id",
        "status",
        "priority",
        "created_at",
        "updated_at",
        "server_created_at",
        "server_updated_at",
        "name_of_organization",
        "organisation_email",
        "state",
        "district",
        "profile"
      ]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Public inquiry submitted through the Contact SEVA form.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 150 },
        "email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 30 },
        "organisation": { "type": "string", "maxLength": 200 },
        "subject": { "type": "string", "maxLength": 250 },
        "message": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "submitted_at": { "type": "string", "minLength": 10, "maxLength": 64 },
        "server_created_at": { "type": "string", "format": "date-time" },
        "status": {
          "type": "string",
          "maxLength": 30,
          "enum": ["Unread", "Read", "Replied"]
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "message",
        "submitted_at",
        "server_created_at",
        "status"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorised SEVA administrator record for role-based access.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "role": { "type": "string", "enum": ["super_admin", "programme_admin", "reviewer"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "created_at"]
    }
  },
  "firestore": {
    "/applications/{applicationId}": {
      "schema": { "$ref": "#/entities/Application" },
      "description": "Submitted grassroots NGO applications. Public create-only; read/update/delete strictly restricted to verified SEVA admins."
    },
    "/contact_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Public inquiries submitted from the Contact page. Public create-only; read/update/delete strictly restricted to verified SEVA admins."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Verified SEVA admin accounts."
    }
  }
}
