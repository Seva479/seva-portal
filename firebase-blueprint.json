{
  "entities": {
    "Application": {
      "title": "Application",
      "description": "Grassroots organisation technology support application submitted via the public 32-field Apply form and managed by SEVA admins.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 5,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique application reference ID (e.g. SEVA-2026-1119-4821)"
        },
        "status": {
          "type": "string",
          "maxLength": 60,
          "enum": [
            "New Application",
            "Under Initial Review",
            "Additional Information Required",
            "Shortlisted",
            "Meeting Scheduled",
            "Approved",
            "Rejected",
            "On Hold",
            "Agreement Pending",
            "Implementation Started",
            "Implementation Completed"
          ]
        },
        "priority": {
          "type": "string",
          "maxLength": 20,
          "enum": ["High", "Medium", "Low"]
        },
        "created_at": { "type": "string", "maxLength": 64 },
        "updated_at": { "type": "string", "maxLength": 64 },
        "server_created_at": { "type": "string", "format": "date-time" },
        "server_updated_at": { "type": "string", "format": "date-time" },
        "name_of_organization": { "type": "string", "minLength": 2, "maxLength": 250 },
        "type_of_organization": { "type": "string", "minLength": 2, "maxLength": 120 },
        "year_of_establishment": { "type": "number" },
        "registration_number": { "type": "string", "minLength": 1, "maxLength": 120 },
        "state": { "type": "string", "minLength": 2, "maxLength": 100 },
        "district": { "type": "string", "minLength": 2, "maxLength": 100 },
        "organisation_address": { "type": "string", "minLength": 2, "maxLength": 600 },
        "organisation_website": { "type": "string", "maxLength": 300 },
        "organisation_email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "contact_person_name": { "type": "string", "minLength": 2, "maxLength": 150 },
        "designation": { "type": "string", "minLength": 1, "maxLength": 150 },
        "contact_number": { "type": "string", "minLength": 7, "maxLength": 25 },
        "brief_description": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "key_areas_of_work": { "type": "array" },
        "villages_covered": { "type": "number" },
        "geographical_area_of_operation": { "type": "string", "minLength": 1, "maxLength": 500 },
        "annual_beneficiaries_reached": { "type": "number" },
        "primary_beneficiaries": { "type": "string", "minLength": 1, "maxLength": 500 },
        "has_website": { "type": "boolean" },
        "has_mis_system": { "type": "boolean" },
        "current_digital_tools": { "type": "array" },
        "major_technology_challenges": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "support_type_seeking": { "type": "array" },
        "description_of_solution_needed": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "main_problem_to_solve": { "type": "string", "minLength": 1, "maxLength": 2500 },
        "intended_users": { "type": "string", "minLength": 1, "maxLength": 500 },
        "estimated_users_count": { "type": "number" },
        "has_previous_digital_project": { "type": "boolean" },
        "previous_digital_project_details": { "type": "string", "maxLength": 3000 },
        "requirement_urgency": { "type": "string", "minLength": 2, "maxLength": 100 },
        "preferred_timeline": { "type": "string", "minLength": 1, "maxLength": 200 },
        "first_priority_support": { "type": "string", "minLength": 1, "maxLength": 500 },
        "documents": { "type": "array" },
        "status_history": { "type": "array" },
        "reviews": { "type": "object" },
        "assigned_reviewer_id": { "type": "string", "maxLength": 128 },
        "assigned_reviewer_name": { "type": "string", "maxLength": 150 }
      },
      "required": [
        "id",
        "status",
        "priority",
        "created_at",
        "updated_at",
        "server_created_at",
        "server_updated_at",
        "name_of_organization",
        "type_of_organization",
        "year_of_establishment",
        "registration_number",
        "state",
        "district",
        "organisation_address",
        "organisation_email",
        "contact_person_name",
        "designation",
        "contact_number",
        "brief_description",
        "key_areas_of_work",
        "villages_covered",
        "geographical_area_of_operation",
        "annual_beneficiaries_reached",
        "primary_beneficiaries",
        "has_website",
        "has_mis_system",
        "current_digital_tools",
        "major_technology_challenges",
        "support_type_seeking",
        "description_of_solution_needed",
        "main_problem_to_solve",
        "intended_users",
        "estimated_users_count",
        "has_previous_digital_project",
        "requirement_urgency",
        "preferred_timeline",
        "first_priority_support"
      ]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Public inquiry submitted through the Contact SEVA form.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 150 },
        "email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 30 },
        "organisation": { "type": "string", "maxLength": 200 },
        "subject": { "type": "string", "maxLength": 250 },
        "message": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "submitted_at": { "type": "string", "maxLength": 64 },
        "server_created_at": { "type": "string", "format": "date-time" },
        "status": {
          "type": "string",
          "maxLength": 30,
          "enum": ["Unread", "Read", "Replied"]
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "message",
        "submitted_at",
        "server_created_at",
        "status"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorised SEVA administrator record for role-based access.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "role": { "type": "string", "enum": ["super_admin", "programme_admin", "reviewer"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "created_at"]
    }
  },
  "firestore": {
    "/applications/{applicationId}": {
      "schema": { "$ref": "#/entities/Application" },
      "description": "Submitted grassroots NGO applications. Public create-only; read/update/delete strictly restricted to verified SEVA admins."
    },
    "/contact_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Public inquiries submitted from the Contact page. Public create-only; read/update/delete strictly restricted to verified SEVA admins."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Verified SEVA admin accounts."
    }
  }
}
