rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Hardened Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 3 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAdminEmail() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in [
          'seva.ecology@gmail.com',
          'programmes@sevavillage.org',
          'admin@sevavillage.org'
        ];
    }

    function isAdmin() {
      return isVerifiedAdminEmail() || (
        isSignedIn() &&
        request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isValidMapList(val, maxItems) {
      return val is list &&
        val.size() <= maxItems &&
        (val.size() == 0 || val[0] is map);
    }

    function isValidStatus(status) {
      return status is string && status.size() <= 60 && status in [
        'New Application',
        'Under Initial Review',
        'Additional Information Required',
        'Shortlisted',
        'Meeting Scheduled',
        'Approved',
        'Rejected',
        'On Hold',
        'Agreement Pending',
        'Implementation Started',
        'Implementation Completed'
      ];
    }

    function isValidPriority(priority) {
      return priority is string && priority.size() <= 20 && priority in ['High', 'Medium', 'Low'];
    }

    // --- Validation Blueprints (Lean, <180 expressions, Eight-Pillars Hardened) ---
    function isValidApplication(data, applicationId) {
      return data.keys().hasAll([
          'id',
          'status',
          'priority',
          'created_at',
          'updated_at',
          'server_created_at',
          'server_updated_at',
          'name_of_organization',
          'organisation_email',
          'state',
          'district',
          'profile'
        ]) &&
        data.keys().hasOnly([
          'id',
          'status',
          'priority',
          'created_at',
          'updated_at',
          'server_created_at',
          'server_updated_at',
          'name_of_organization',
          'organisation_email',
          'state',
          'district',
          'profile',
          'documents',
          'status_history',
          'reviews',
          'assigned_reviewer_id',
          'assigned_reviewer_name'
        ]) &&
        isValidId(data.id) &&
        data.id == applicationId &&
        isValidStatus(data.status) &&
        isValidPriority(data.priority) &&
        isValidString(data.created_at, 10, 64) &&
        isValidString(data.updated_at, 10, 64) &&
        data.server_created_at is timestamp &&
        data.server_updated_at is timestamp &&
        isValidString(data.name_of_organization, 1, 250) &&
        isValidString(data.organisation_email, 3, 200) &&
        isValidString(data.state, 1, 100) &&
        isValidString(data.district, 1, 100) &&
        data.profile is map &&
        data.profile.size() <= 40 &&
        (!('documents' in data) || isValidMapList(data.documents, 10)) &&
        (!('status_history' in data) || isValidMapList(data.status_history, 50)) &&
        (!('reviews' in data) || (data.reviews is map && data.reviews.size() <= 30)) &&
        isValidOptionalString(data, 'assigned_reviewer_id', 128) &&
        isValidOptionalString(data, 'assigned_reviewer_name', 150);
    }

    function isValidContactMessage(data, messageId) {
      return data.keys().hasAll([
          'id',
          'name',
          'email',
          'message',
          'submitted_at',
          'server_created_at',
          'status'
        ]) &&
        data.keys().hasOnly([
          'id',
          'name',
          'email',
          'phone',
          'organisation',
          'subject',
          'message',
          'submitted_at',
          'server_created_at',
          'status'
        ]) &&
        isValidId(data.id) &&
        data.id == messageId &&
        isValidString(data.name, 1, 150) &&
        isValidString(data.email, 3, 200) &&
        isValidOptionalString(data, 'phone', 30) &&
        isValidOptionalString(data, 'organisation', 200) &&
        isValidOptionalString(data, 'subject', 250) &&
        isValidString(data.message, 1, 4000) &&
        isValidString(data.submitted_at, 10, 64) &&
        data.server_created_at is timestamp &&
        data.status is string && data.status.size() <= 30 &&
        data.status in ['Unread', 'Read', 'Replied'];
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'role', 'created_at']) &&
        data.keys().hasOnly(['email', 'role', 'created_at']) &&
        isValidString(data.email, 3, 200) &&
        data.role is string && data.role.size() <= 40 &&
        data.role in ['super_admin', 'programme_admin', 'reviewer'] &&
        data.created_at is timestamp;
    }

    // --- Collection: /applications/{applicationId} ---
    match /applications/{applicationId} {
      // Public intake: unauthenticated NGOs can submit new applications ONLY with strict schema validation
      allow create: if isValidId(applicationId) &&
        isValidApplication(incoming(), applicationId) &&
        incoming().server_created_at == request.time &&
        incoming().server_updated_at == request.time &&
        (
          (
            incoming().status == 'New Application' &&
            incoming().priority == 'Medium' &&
            !('reviews' in incoming())
          ) ||
          isAdmin()
        );

      // PII Isolation: Only verified SEVA admins can read applications
      allow get: if isValidId(applicationId) && isAdmin();
      allow list: if isVerifiedAdminEmail();

      // Action-Based Update: Only verified SEVA admins can update status, priority, reviews, or reviewer assignment
      allow update: if isSignedIn() &&
        isValidId(applicationId) &&
        isValidApplication(incoming(), applicationId) &&
        isAdmin() &&
        incoming().id == existing().id &&
        incoming().server_created_at == existing().server_created_at &&
        incoming().server_updated_at == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'status',
            'status_history',
            'updated_at',
            'server_updated_at'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'reviews',
            'priority',
            'updated_at',
            'server_updated_at'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'assigned_reviewer_id',
            'assigned_reviewer_name',
            'updated_at',
            'server_updated_at'
          ])
        );

      allow delete: if isValidId(applicationId) && isAdmin();
    }

    // --- Collection: /contact_messages/{messageId} ---
    match /contact_messages/{messageId} {
      allow create: if isValidId(messageId) &&
        isValidContactMessage(incoming(), messageId) &&
        incoming().status == 'Unread' &&
        incoming().server_created_at == request.time;

      allow get: if isValidId(messageId) && isAdmin();
      allow list: if isVerifiedAdminEmail();

      allow update: if isSignedIn() &&
        isValidId(messageId) &&
        isValidContactMessage(incoming(), messageId) &&
        isAdmin() &&
        incoming().id == existing().id &&
        incoming().server_created_at == existing().server_created_at &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status']);

      allow delete: if isValidId(messageId) && isAdmin();
    }

    // --- Collection: /admins/{uid} ---
    match /admins/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (request.auth.uid == uid || isAdmin());
      allow list: if isVerifiedAdminEmail();
      allow create: if isSignedIn() &&
        isValidId(uid) &&
        isValidAdminUser(incoming()) &&
        isAdmin() &&
        incoming().created_at == request.time;
      allow update: if isSignedIn() &&
        isValidId(uid) &&
        isValidAdminUser(incoming()) &&
        isAdmin() &&
        incoming().created_at == existing().created_at &&
        incoming().diff(existing()).affectedKeys().hasOnly(['role', 'email']);
      allow delete: if isValidId(uid) && isAdmin();
    }
  }
}
